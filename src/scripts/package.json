{
  "name": "scripts-tools",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx GenerateConversations/generateConversations.ts",
    "gen": "node dist/GenerateConversations/generateConversations.js",
    "eval": "tsx EvaluateConversation/evaluateConversation.ts",
    "gen:500": "tsx GenerateConversations/generateConversations.ts --count=500 --min-turns=10 --max-turns=18 --chaos=0.5 --compliant-conversation-ratio=0.85 --adherence-ratio=0.9 --noncompliant-adherence-ratio=0.3 --out=GenerateConversations/results --prefix=conv",
    "eval:results": "tsx EvaluateConversation/evaluateConversation.ts --in=GenerateConversations/results --out=EvaluateConversation/results.json",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "openai": "^5.15.0",
    "zod": "^3.25.76"
  }
}
